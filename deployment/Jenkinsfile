pipeline {

    agent any

    environment {

        // ==========================================
        // AWS CONFIGURATION
        // ==========================================

        AWS_REGION = 'ap-south-1'

        PROJECT_NAME = 'vms360'

        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_ACCOUNT_ID = credentials('aws-rahul-account-id')

        S3_ENV_BUCKET = 'its360-secure-env-file'

        CODEBUILD_PROJECT_NAME = 'vms360-build'

        FRONTEND_ECR_REPOSITORY = 'vms360-frontend'
        BACKEND_ECR_REPOSITORY = 'vms360-backend'

        ECS_CLUSTER = 'its360-cluster'

        // ==========================================
        // ENVIRONMENT FILES
        // ==========================================

        BACKEND_PRODUCTION_ENV_S3_KEY = 'vms-360-backend-production-env'
        FRONTEND_PRODUCTION_ENV_S3_KEY = 'vms-360-frontend-production-env'

        BACKEND_STAGING_ENV_S3_KEY = 'vms-360-backend-production-env'
        FRONTEND_STAGING_ENV_S3_KEY = 'vms-360-frontend-production-env'

        // ==========================================
        // ECS TASK CONFIGURATION
        // ==========================================

        FRONTEND_TASK_DEFINITION_FAMILY = 'itsoftlab-360-vms360-frontend'
        BACKEND_TASK_DEFINITION_FAMILY = 'itsoftlab-360-vms360-backend'

        FRONTEND_CONTAINER_NAME = 'vms360-frontend'
        BACKEND_CONTAINER_NAME = 'vms360-backend'

        FRONTEND_CONTAINER_PORT = '80'
        BACKEND_CONTAINER_PORT = '5000'

        FRONTEND_CPU = '256'
        FRONTEND_MEMORY = '512'

        BACKEND_CPU = '256'
        BACKEND_MEMORY = '512'

        FRONTEND_HEALTH_PATH = '/api/health'
        BACKEND_HEALTH_PATH = '/api/health'

        // ==========================================
        // ECS SERVICES
        // ==========================================

        FRONTEND_SERVICE = 'vms360-frontend-service'
        BACKEND_SERVICE = 'vms360-backend-service'

        // ==========================================
        // APPLICATION LOAD BALANCERS
        // ==========================================

        FRONTEND_LOAD_BALANCER = 'master-load-balancer'
        BACKEND_LOAD_BALANCER = 'master-load-balancer'

        FRONTEND_TARGET_GROUP = 'vms360-frontend-tg'
        BACKEND_TARGET_GROUP = 'vms360-backend-tg'

    }

    stages {

        stage('Validate Git Tag') {
            steps {
                script {
                    // Use tag(s) pointing at HEAD to avoid picking an unrelated latest tag
                    env.TAG_NAME = sh(script: 'git tag --points-at HEAD | sort -V | tail -n 1 || echo ""', returnStdout: true).trim()

                    if (!env.TAG_NAME) {
                        error '❌ No tag detected! Deployment only triggers on tag creation.'
                    }
                    echo "📌 Detected Tag: ${env.TAG_NAME}"

                    // Extract branch from which the tag originated.
                    env.BRANCH = sh(script: "git branch -r --contains ${env.TAG_NAME} | grep -Eo 'origin/(main|staging)' | head -n 1 | cut -d '/' -f2 || echo ''", returnStdout: true).trim()
                    if (!env.BRANCH) {
                        error "❌ Invalid tag! Tags must be from 'main', 'staging' branches."
                    }

                    if (env.BRANCH == 'main' && env.TAG_NAME ==~ /^v\d+\.\d+\.\d+$/) {
                        env.ENVIRONMENT = 'production'
                    } else if (env.BRANCH == 'staging' && env.TAG_NAME ==~ /^v\d+\.\d+\.\d+-staging$/) {
                        env.ENVIRONMENT = 'staging'
                    } else {
                        error "❌ Invalid tag format for branch '${env.BRANCH}'."
                    }
                    echo "🌍 Deployment Environment: ${env.ENVIRONMENT}"
                    echo "Project: ${PROJECT_NAME}"
                    echo "Branch: ${env.BRANCH}"
                    echo "Tag: ${env.TAG_NAME}"
                }
            }
        }

        stage('Create Docker Tags') {
            steps {
                script {
                    env.BACKEND_TAG = "backend-${env.ENVIRONMENT}-${env.TAG_NAME}"
                    env.FRONTEND_TAG = "frontend-${env.ENVIRONMENT}-${env.TAG_NAME}"
                    echo "🛠️ Backend Tag: ${env.BACKEND_TAG}"
                    echo "🛠️ Frontend Tag: ${env.FRONTEND_TAG}"
                }
            }
        }


        stage('Determine secret key file') {
            steps {
                script {
                    // -------------------------------------------------
                    // Make sure environment was determined correctly
                    // -------------------------------------------------
                    if (!env.ENVIRONMENT) {
                        error """
                        ❌ Secret key determination failed.

                        ENVIRONMENT is not available.

                        The 'Validate Git Tag' stage must complete
                        successfully before this stage.
                        """
                    }

                    if (env.ENVIRONMENT == 'production') {

                        env.BACKEND_SECRET_KEY = "${env.BACKEND_PRODUCTION_ENV_S3_KEY}.env"

                        env.FRONTEND_SECRET_KEY = "${env.FRONTEND_PRODUCTION_ENV_S3_KEY}.env"
                    }

                    else if (env.ENVIRONMENT == 'staging') {

                        env.BACKEND_SECRET_KEY = "${env.BACKEND_STAGING_ENV_S3_KEY}.env"

                        env.FRONTEND_SECRET_KEY = "${env.FRONTEND_STAGING_ENV_S3_KEY}.env"
                    }

                    else {
                        error "❌ Unknown deployment environment: ${env.ENVIRONMENT}"
                    }

                    echo "🔐 Backend env file: ${env.BACKEND_SECRET_KEY}"
                    echo "🔐 Frontend env file: ${env.FRONTEND_SECRET_KEY}"
                }
            }
        }


        stage('Check and Trigger AWS CodeBuild') {
            steps {
                script {

                    echo "============================================"
                    echo "AWS CodeBuild Validation & Trigger"
                    echo "============================================"
                    echo "Project     : ${PROJECT_NAME}"
                    echo "Environment : ${ENVIRONMENT}"
                    echo "AWS Region  : ${AWS_REGION}"
                    echo "CodeBuild   : ${CODEBUILD_PROJECT_NAME}"
                    echo "============================================"

                    // -------------------------------------------------
                    // Check CodeBuild project
                    // -------------------------------------------------

                    def codeBuildStatus = sh(
                        script: """
                            aws codebuild batch-get-projects \
                                --names "${CODEBUILD_PROJECT_NAME}" \
                                --region "${AWS_REGION}" \
                                --query 'projects[0].name' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!codeBuildStatus ||
                        codeBuildStatus == 'None' ||
                        codeBuildStatus == 'null') {

                        error """
                        ❌ AWS CodeBuild project not found.

                        Project     : ${CODEBUILD_PROJECT_NAME}
                        Environment : ${ENVIRONMENT}
                        AWS Region  : ${AWS_REGION}
                        AWS Account : ${AWS_ACCOUNT_ID}
                        """
                    }

                    echo "✅ CodeBuild project exists: ${codeBuildStatus}"

                    // -------------------------------------------------
                    // Check whether the exact images already exist
                    // -------------------------------------------------

                    def backendExists = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${BACKEND_ECR_REPOSITORY} \
                                --image-ids imageTag=${BACKEND_TAG} \
                                --region ${AWS_REGION} \
                                >/dev/null 2>&1
                        """,
                        returnStatus: true
                    ) == 0

                    def frontendExists = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${FRONTEND_ECR_REPOSITORY} \
                                --image-ids imageTag=${FRONTEND_TAG} \
                                --region ${AWS_REGION} \
                                >/dev/null 2>&1
                        """,
                        returnStatus: true
                    ) == 0

                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    env.FRONTEND_IMAGE = "${env.ECR_REGISTRY}/${FRONTEND_ECR_REPOSITORY}:${env.FRONTEND_TAG}"
                    env.BACKEND_IMAGE  = "${env.ECR_REGISTRY}/${BACKEND_ECR_REPOSITORY}:${env.BACKEND_TAG}"

                    if (backendExists && frontendExists) {

                        env.CODEBUILD_BUILD_ID = 'SKIPPED'

                        echo "✅ Both exact images already exist in ECR."
                        echo "Frontend: ${env.FRONTEND_IMAGE}"
                        echo "Backend : ${env.BACKEND_IMAGE}"
                        echo "⏭️ Skipping CodeBuild."

                    } else {

                        echo "🚀 Starting AWS CodeBuild..."
                        echo "Frontend image exists: ${frontendExists}"
                        echo "Backend image exists : ${backendExists}"

                        def buildId = sh(
                            script: """
                                aws codebuild start-build \
                                    --project-name "${CODEBUILD_PROJECT_NAME}" \
                                    --source-version "${TAG_NAME}" \
                                    --region "${AWS_REGION}" \
                                    --environment-variables-override \
                                        name=ENVIRONMENT,value=${ENVIRONMENT},type=PLAINTEXT \
                                        name=PROJECT_NAME,value=${PROJECT_NAME},type=PLAINTEXT \
                                        name=GIT_TAG,value=${TAG_NAME},type=PLAINTEXT \
                                        name=BACKEND_TAG,value=${BACKEND_TAG},type=PLAINTEXT \
                                        name=FRONTEND_TAG,value=${FRONTEND_TAG},type=PLAINTEXT \
                                        name=BACKEND_SECRET_KEY,value=${BACKEND_SECRET_KEY},type=PLAINTEXT \
                                        name=FRONTEND_SECRET_KEY,value=${FRONTEND_SECRET_KEY},type=PLAINTEXT \
                                        name=S3_ENV_BUCKET,value=${S3_ENV_BUCKET},type=PLAINTEXT \
                                    --query 'build.id' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()

                        if (!buildId ||
                            buildId == 'None' ||
                            buildId == 'null') {

                            error "❌ Failed to start AWS CodeBuild."
                        }
                        env.CODEBUILD_BUILD_ID = buildId

                        echo "✅ AWS CodeBuild started."
                        echo "Build ID: ${env.CODEBUILD_BUILD_ID}"
                    }

                    echo "============================================"
                    echo "CodeBuild Result"
                    echo "============================================"
                    echo "Build ID      : ${env.CODEBUILD_BUILD_ID}"
                    echo "Frontend Image: ${env.FRONTEND_IMAGE}"
                    echo "Backend Image : ${env.BACKEND_IMAGE}"
                    echo "============================================"
                }
            }
        }


        stage('Wait for AWS CodeBuild Completion') {
            when {
                expression {
                    env.CODEBUILD_BUILD_ID && env.CODEBUILD_BUILD_ID != 'SKIPPED'
                }
            }
            steps {
                script {

                    echo "⏳ Waiting for AWS CodeBuild to complete..."

                    timeout(time: 30, unit: 'MINUTES') {

                        def buildStatus = ''

                        while (true) {

                            buildStatus = sh(
                                script: """
                                    aws codebuild batch-get-builds \
                                        --ids ${CODEBUILD_BUILD_ID} \
                                        --region ${AWS_REGION} \
                                        --query 'builds[0].buildStatus' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()

                            echo "Build status: ${buildStatus}"

                            if ([
                                'SUCCEEDED',
                                'FAILED',
                                'STOPPED',
                                'FAULT',
                                'TIMED_OUT'
                            ].contains(buildStatus)) {
                                break
                            }

                            sleep 10
                        }

                        if (buildStatus != 'SUCCEEDED') {
                            error "❌ AWS CodeBuild failed with status: ${buildStatus}"
                        }

                        echo "✅ AWS CodeBuild completed successfully."
                    }
                }
            }
        }


        stage('Verify ECR Images') {
            steps {
                script {

                    echo "🔍 Verifying frontend and backend images in ECR..."

                    sh """
                        aws ecr describe-images \
                            --repository-name ${FRONTEND_ECR_REPOSITORY} \
                            --image-ids imageTag=${FRONTEND_TAG} \
                            --region ${AWS_REGION} \
                            --query 'imageDetails[0].imageTags' \
                            --output text
                    """

                    sh """
                        aws ecr describe-images \
                            --repository-name ${BACKEND_ECR_REPOSITORY} \
                            --image-ids imageTag=${BACKEND_TAG} \
                            --region ${AWS_REGION} \
                            --query 'imageDetails[0].imageTags' \
                            --output text
                    """

                    echo "✅ Both required ECR images are available."

                    echo "Frontend image: ${FRONTEND_IMAGE}"
                    echo "Backend image : ${BACKEND_IMAGE}"
                }
            }
        }


        stage('Generate Frontend Task Definition') {

            steps {

                script {

                    echo "📝 Generating frontend ECS task definition..."

                    // ==========================================
                    // Frontend Task Definition Variables
                    // ==========================================

                    env.FRONTEND_TASK_FAMILY = "${FRONTEND_TASK_DEFINATION_FAMILY}"

                    env.FRONTEND_CONTAINER_NAME = "${PROJECT_NAME}-frontend"

                    env.FRONTEND_CONTAINER_PORT = "${FRONTEND_CONTAINER_PORT}"

                    env.FRONTEND_EXECUTION_ROLE = "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole"

                    env.FRONTEND_TASK_ROLE = "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskRole"

                    env.FRONTEND_LOG_GROUP =  "/ecs/${FRONTEND_TASK_FAMILY}"


                    // ==========================================
                    // S3 Environment File ARN
                    // ==========================================

                    env.FRONTEND_ENV_FILE_ARN = "arn:aws:s3:::its360-secure-env-file/${FRONTEND_SECRET_KEY}"


                    echo "📦 Task Family      : ${FRONTEND_TASK_FAMILY}"
                    echo "📦 Container        : ${FRONTEND_CONTAINER_NAME}"
                    echo "📦 Image            : ${FRONTEND_IMAGE}"
                    echo "📦 Container Port   : ${FRONTEND_CONTAINER_PORT}"
                    echo "🔐 Environment File : ${FRONTEND_ENV_FILE_ARN}"
                    echo "📋 Log Group        : ${FRONTEND_LOG_GROUP}"


                    // ==========================================
                    // Generate Task Definition JSON
                    // ==========================================

                    sh """
        cat > frontend-task-definition.json <<EOF
    {
        "family": "${FRONTEND_TASK_FAMILY}",

        "executionRoleArn": "${FRONTEND_EXECUTION_ROLE}",

        "taskRoleArn": "${FRONTEND_TASK_ROLE}",

        "networkMode": "awsvpc",

        "requiresCompatibilities": [
            "FARGATE"
        ],

        "cpu": "256",

        "memory": "512",

        "runtimePlatform": {
            "cpuArchitecture": "X86_64",
            "operatingSystemFamily": "LINUX"
        },

        "containerDefinitions": [
            {
                "name": "${FRONTEND_CONTAINER_NAME}",

                "image": "${FRONTEND_IMAGE}",

                "cpu": 0,

                "portMappings": [
                    {
                        "containerPort": ${FRONTEND_CONTAINER_PORT},
                        "hostPort": ${FRONTEND_CONTAINER_PORT},
                        "protocol": "tcp",
                        "name": "frontend-${FRONTEND_CONTAINER_PORT}-tcp",
                        "appProtocol": "http"
                    }
                ],

                "essential": true,

                "environment": [],

                "environmentFiles": [
                    {
                        "value": "${FRONTEND_ENV_FILE_ARN}",
                        "type": "s3"
                    }
                ],

                "mountPoints": [],

                "volumesFrom": [],

                "ulimits": [],

                "logConfiguration": {
                    "logDriver": "awslogs",

                    "options": {
                        "awslogs-group": "${FRONTEND_LOG_GROUP}",
                        "awslogs-create-group": "true",
                        "awslogs-region": "${AWS_REGION}",
                        "awslogs-stream-prefix": "ecs"
                    }
                },

                "healthCheck": {
                    "command": [
                        "CMD-SHELL",
                        "curl -f http://localhost:${FRONTEND_CONTAINER_PORT}${FRONTEND_HEALTH_API} || exit 1"
                    ],

                    "interval": 30,
                    "timeout": 5,
                    "retries": 3,
                    "startPeriod": 10
                }
            }
        ]
    }
EOF
"""


                    // ==========================================
                    // Validate Generated JSON
                    // ==========================================

                    echo "🔍 Validating generated task definition..."

                    sh """
                        jq empty frontend-task-definition.json
                    """

                    echo "✅ Frontend task definition JSON is valid."


                    // ==========================================
                    // Display Safe Configuration
                    // ==========================================

                    echo ""
                    echo "=========================================="
                    echo "✅ FRONTEND TASK DEFINITION GENERATED"
                    echo "=========================================="

                    sh """
                        jq '{
                            family,
                            executionRoleArn,
                            networkMode,
                            requiresCompatibilities,
                            cpu,
                            memory,
                            runtimePlatform,
                            containerDefinitions: [
                                {
                                    name: .containerDefinitions[0].name,
                                    image: .containerDefinitions[0].image,
                                    portMappings: .containerDefinitions[0].portMappings,
                                    environmentFiles: .containerDefinitions[0].environmentFiles,
                                    healthCheck: .containerDefinitions[0].healthCheck
                                }
                            ]
                        }' frontend-task-definition.json
                    """

                    echo "=========================================="
                }
            }
        }

        stage('Generate Backend Task Definition') {

            steps {

                script {

                    echo "📝 Generating backend ECS task definition..."

                    // ==========================================
                    // Backend Task Definition Variables
                    // ==========================================

                    env.BACKEND_TASK_FAMILY = "${BACKEND_TASK_DEFINATION_FAMILY}"

                    env.BACKEND_CONTAINER_NAME = "${PROJECT_NAME}-backend"

                    env.BACKEND_CONTAINER_PORT = "${BACKEND_CONTAINER_PORT}"

                    env.BACKEND_EXECUTION_ROLE = "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskExecutionRole"
                    env.BACKEND_TASK_ROLE = "arn:aws:iam::${AWS_ACCOUNT_ID}:role/ecsTaskRole"

                    env.BACKEND_LOG_GROUP = "/ecs/${BACKEND_TASK_FAMILY}"


                    // ==========================================
                    // S3 Environment File ARN
                    // ==========================================

                    env.BACKEND_ENV_FILE_ARN =  "arn:aws:s3:::its360-secure-env-file/${BACKEND_SECRET_KEY}"


                    // ==========================================
                    // Display Configuration
                    // ==========================================

                    echo "📦 Task Family       : ${BACKEND_TASK_FAMILY}"
                    echo "📦 Container         : ${BACKEND_CONTAINER_NAME}"
                    echo "📦 Image             : ${BACKEND_IMAGE}"
                    echo "📦 Container Port    : ${BACKEND_CONTAINER_PORT}"
                    echo "🔐 Environment File  : ${BACKEND_ENV_FILE_ARN}"
                    echo "📋 Log Group         : ${BACKEND_LOG_GROUP}"


                    // ==========================================
                    // Generate Backend Task Definition JSON
                    // ==========================================

                    sh """
    cat > backend-task-definition.json <<EOF

    {
        "family": "${BACKEND_TASK_FAMILY}",

        "executionRoleArn": "${BACKEND_EXECUTION_ROLE}",

        "taskRoleArn": "${BACKEND_TASK_ROLE}",

        "networkMode": "awsvpc",

        "requiresCompatibilities": [
            "FARGATE"
        ],

        "cpu": "256",

        "memory": "512",

        "runtimePlatform": {
            "cpuArchitecture": "X86_64",
            "operatingSystemFamily": "LINUX"
        },

        "containerDefinitions": [
            {
                "name": "${BACKEND_CONTAINER_NAME}",

                "image": "${BACKEND_IMAGE}",

                "cpu": 0,

                "portMappings": [
                    {
                        "containerPort": ${BACKEND_CONTAINER_PORT},
                        "hostPort": ${BACKEND_CONTAINER_PORT},
                        "protocol": "tcp",
                        "name": "backend-${BACKEND_CONTAINER_PORT}-tcp",
                        "appProtocol": "http"
                    }
                ],

                "essential": true,

                "environment": [],

                "environmentFiles": [
                    {
                        "value": "${BACKEND_ENV_FILE_ARN}",
                        "type": "s3"
                    }
                ],

                "mountPoints": [],

                "volumesFrom": [],

                "ulimits": [],

                "logConfiguration": {
                    "logDriver": "awslogs",

                    "options": {
                        "awslogs-group": "${BACKEND_LOG_GROUP}",
                        "awslogs-create-group": "true",
                        "awslogs-region": "${AWS_REGION}",
                        "awslogs-stream-prefix": "ecs"
                    }
                },

                "healthCheck": {
                    "command": [
                        "CMD-SHELL",
                        "curl --fail --silent http://127.0.0.1:${BACKEND_CONTAINER_PORT}${BACKEND_HEALTH_API} > /dev/null || exit 1"
                    ],
                    "interval": 30,
                    "timeout": 5,
                    "retries": 3,
                    "startPeriod": 60
                }
            }
        ]
    }

EOF
"""


                    // ==========================================
                    // Validate Generated JSON
                    // ==========================================

                    echo "🔍 Validating generated backend task definition..."

                    sh """
                        jq empty backend-task-definition.json
                    """

                    echo "✅ Backend task definition JSON is valid."


                    // ==========================================
                    // Display Safe Configuration
                    // ==========================================

                    echo ""
                    echo "=========================================="
                    echo "✅ BACKEND TASK DEFINITION GENERATED"
                    echo "=========================================="

                    sh """
                        jq '{
                            family,
                            executionRoleArn,
                            taskRoleArn,
                            networkMode,
                            requiresCompatibilities,
                            cpu,
                            memory,
                            runtimePlatform,
                            containerDefinitions: [
                                {
                                    name: .containerDefinitions[0].name,
                                    image: .containerDefinitions[0].image,
                                    portMappings: .containerDefinitions[0].portMappings,
                                    environmentFiles: .containerDefinitions[0].environmentFiles,
                                    healthCheck: .containerDefinitions[0].healthCheck
                                }
                            ]
                        }' backend-task-definition.json
                    """

                    echo "=========================================="
                }
            }
        }

        stage('Register Task Definitions') {

            steps {

                script {

                    echo "📋 Registering ECS task definitions..."

                    // ==========================================
                    // Register Frontend Task Definition
                    // ==========================================

                    echo "🚀 Registering frontend task definition..."

                    def frontendTaskDefinitionArn = sh(
                        script: """
                            aws ecs register-task-definition \
                                --cli-input-json file://frontend-task-definition.json \
                                --region ${AWS_REGION} \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!frontendTaskDefinitionArn) {
                        error "❌ Failed to register frontend task definition."
                    }

                    env.FRONTEND_TASK_DEFINITION_ARN = frontendTaskDefinitionArn

                    echo "✅ Frontend task definition registered:"
                    echo "${env.FRONTEND_TASK_DEFINITION_ARN}"


                    // ==========================================
                    // Register Backend Task Definition
                    // ==========================================

                    echo "🚀 Registering backend task definition..."

                    def backendTaskDefinitionArn = sh(
                        script: """
                            aws ecs register-task-definition \
                                --cli-input-json file://backend-task-definition.json \
                                --region ${AWS_REGION} \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (!backendTaskDefinitionArn) {
                        error "❌ Failed to register backend task definition."
                    }

                    env.BACKEND_TASK_DEFINITION_ARN = backendTaskDefinitionArn

                    echo "✅ Backend task definition registered:"
                    echo "${env.BACKEND_TASK_DEFINITION_ARN}"


                    // ==========================================
                    // Summary
                    // ==========================================

                    echo ""
                    echo "=========================================="
                    echo "✅ TASK DEFINITIONS REGISTERED"
                    echo "=========================================="
                    echo "Frontend:"
                    echo "${env.FRONTEND_TASK_DEFINITION_ARN}"
                    echo ""
                    echo "Backend:"
                    echo "${env.BACKEND_TASK_DEFINITION_ARN}"
                    echo "=========================================="
                }
            }
        }


        stage('Update ECS Services') {
            steps {
                script {
                    def clusterStatus = sh(
                        script: "aws ecs describe-clusters --clusters ${ECS_CLUSTER} --region ${AWS_REGION} --query 'clusters[0].status' --output text",
                        returnStdout: true
                    ).trim()
                    if (clusterStatus != 'ACTIVE') {
                        error "❌ ECS cluster '${ECS_CLUSTER}' is not ACTIVE (status: ${clusterStatus})."
                    }

                    // Read-only lookups, needed by the Health Check stage
                    env.FRONTEND_TARGET_GROUP_ARN = sh(
                        script: "aws elbv2 describe-target-groups --names ${FRONTEND_TARGET_GROUP} --region ${AWS_REGION} --query 'TargetGroups[0].TargetGroupArn' --output text",
                        returnStdout: true
                    ).trim()
                    env.BACKEND_TARGET_GROUP_ARN = sh(
                        script: "aws elbv2 describe-target-groups --names ${BACKEND_TARGET_GROUP} --region ${AWS_REGION} --query 'TargetGroups[0].TargetGroupArn' --output text",
                        returnStdout: true
                    ).trim()

                    // Services must already exist; a deploy only rolls them to the new task definition
                    def services = [
                        [name: env.FRONTEND_SERVICE, taskDef: env.FRONTEND_TASK_DEFINITION_ARN],
                        [name: env.BACKEND_SERVICE,  taskDef: env.BACKEND_TASK_DEFINITION_ARN]
                    ]

                    for (svc in services) {
                        def status = sh(
                            script: "aws ecs describe-services --cluster ${ECS_CLUSTER} --services ${svc.name} --region ${AWS_REGION} --query 'services[0].status' --output text 2>/dev/null || true",
                            returnStdout: true
                        ).trim()

                        if (status != 'ACTIVE') {
                            error "❌ ECS service '${svc.name}' not found or not ACTIVE (status: '${status}'). Create it once manually."
                        }

                        echo "🔄 Updating ${svc.name} -> ${svc.taskDef}"
                        sh """
                            aws ecs update-service \
                                --cluster ${ECS_CLUSTER} \
                                --service ${svc.name} \
                                --task-definition ${svc.taskDef} \
                                --force-new-deployment \
                                --region ${AWS_REGION} \
                                --query 'service.serviceName' --output text
                        """
                    }
                }
            }
        }


        stage('Wait for ECS Stability') {
            steps {
                script {

                    echo ""
                    echo "=========================================="
                    echo "⏳ WAITING FOR ECS SERVICES TO STABILIZE"
                    echo "=========================================="

                    // =========================================================
                    // VALIDATE REQUIRED VARIABLES
                    // =========================================================

                    if (!env.ECS_CLUSTER) {
                        error "❌ ECS_CLUSTER is not available."
                    }

                    if (!env.FRONTEND_SERVICE) {
                        error "❌ FRONTEND_SERVICE is not available."
                    }

                    if (!env.BACKEND_SERVICE) {
                        error "❌ BACKEND_SERVICE is not available."
                    }

                    echo "Cluster          : ${ECS_CLUSTER}"
                    echo "Frontend Service : ${FRONTEND_SERVICE}"
                    echo "Backend Service  : ${BACKEND_SERVICE}"

                    // =========================================================
                    // WAIT FOR FRONTEND SERVICE
                    // =========================================================

                    echo ""
                    echo "🌐 Waiting for frontend ECS service..."

                    sh """
                        aws ecs wait services-stable \
                            --cluster ${ECS_CLUSTER} \
                            --services ${FRONTEND_SERVICE} \
                            --region ${AWS_REGION}
                    """

                    echo "✅ Frontend ECS service is stable."

                    // =========================================================
                    // WAIT FOR BACKEND SERVICE
                    // =========================================================

                    echo ""
                    echo "⚙️ Waiting for backend ECS service..."

                    sh """
                        aws ecs wait services-stable \
                            --cluster ${ECS_CLUSTER} \
                            --services ${BACKEND_SERVICE} \
                            --region ${AWS_REGION}
                    """

                    echo "✅ Backend ECS service is stable."

                    // =========================================================
                    // VERIFY FINAL SERVICE STATUS
                    // =========================================================

                    echo ""
                    echo "🔍 Verifying final ECS service status..."

                    sh """
                        aws ecs describe-services \
                            --cluster ${ECS_CLUSTER} \
                            --services ${FRONTEND_SERVICE} ${BACKEND_SERVICE} \
                            --region ${AWS_REGION} \
                            --query 'services[].{
                                Service:serviceName,
                                Status:status,
                                Desired:desiredCount,
                                Running:runningCount,
                                Pending:pendingCount
                            }' \
                            --output table
                    """

                    echo ""
                    echo "=========================================="
                    echo "✅ ECS SERVICES ARE STABLE"
                    echo "=========================================="
                }
            }
        }


        stage('Health Check') {
            steps {
                script {
                    echo "=========================================="
                    echo "🏥 ECS APPLICATION HEALTH CHECK"
                    echo "=========================================="

                    // =====================================================
                    // 1. VALIDATE REQUIRED ENVIRONMENT VARIABLES
                    // =====================================================

                    def requiredVariables = [
                        'AWS_REGION',
                        'ECS_CLUSTER',
                        'FRONTEND_SERVICE',
                        'BACKEND_SERVICE',
                        'FRONTEND_TARGET_GROUP_ARN',
                        'BACKEND_TARGET_GROUP_ARN'
                    ]

                    if (!env.AWS_REGION?.trim()) {
                        error "AWS_REGION is missing"
                    }

                    if (!env.ECS_CLUSTER?.trim()) {
                        error "ECS_CLUSTER is missing"
                    }

                    if (!env.FRONTEND_SERVICE?.trim()) {
                        error "FRONTEND_SERVICE is missing"
                    }

                    if (!env.BACKEND_SERVICE?.trim()) {
                        error "BACKEND_SERVICE is missing"
                    }

                    if (!env.FRONTEND_TARGET_GROUP_ARN?.trim()) {
                        error "FRONTEND_TARGET_GROUP_ARN is missing"
                    }

                    if (!env.BACKEND_TARGET_GROUP_ARN?.trim()) {
                        error "BACKEND_TARGET_GROUP_ARN is missing"
                    }

                    echo "✅ All required environment variables are available."

                    echo "✅ Required variables are available."
                    echo "AWS region: ${env.AWS_REGION}"
                    echo "ECS cluster: ${env.ECS_CLUSTER}"

                    // =====================================================
                    // 2. WAIT FOR ECS SERVICES TO BECOME STABLE
                    // =====================================================

                    echo "⏳ Waiting for frontend and backend ECS services..."

                    timeout(time: 15, unit: 'MINUTES') {
                        sh(
                            label: 'Wait for ECS services to stabilize',
                            script: '''
                                set -eu

                                aws ecs wait services-stable \
                                    --cluster "$ECS_CLUSTER" \
                                    --services "$FRONTEND_SERVICE" "$BACKEND_SERVICE" \
                                    --region "$AWS_REGION"

                                echo "✅ ECS services have stabilized."
                            '''
                        )
                    }

                    // =====================================================
                    // 3. CHECK ECS SERVICE STATUS AND TASK COUNTS
                    // =====================================================

                    def checkEcsService = { serviceName, serviceLabel ->

                        echo "🔍 Checking ${serviceLabel} ECS service..."

                        def serviceInfo = sh(
                            label: "Check ${serviceLabel} ECS status",
                            script: '''
                                set -eu

                                aws ecs describe-services \
                                    --cluster "$ECS_CLUSTER" \
                                    --services "$SERVICE_NAME" \
                                    --region "$AWS_REGION" \
                                    --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                    --output text
                            ''',
                            returnStdout: true
                        ).trim()

                        // Supply the service name as a shell environment variable.
                        // This avoids Groovy interpolation in the shell command.
                        echo "${serviceLabel} ECS details: ${serviceInfo}"

                        def values = serviceInfo.tokenize()

                        if (values.size() < 4 || values[0] == 'None') {
                            error "❌ Could not retrieve ${serviceLabel} ECS service details."
                        }

                        def status = values[0]
                        def desired = values[1].toInteger()
                        def running = values[2].toInteger()
                        def pending = values[3].toInteger()

                        if (status != 'ACTIVE') {
                            error "❌ ${serviceLabel} ECS service status is ${status}, not ACTIVE."
                        }

                        if (desired < 1) {
                            error "❌ ${serviceLabel} ECS service has no desired tasks."
                        }

                        if (running < desired) {
                            error "❌ ${serviceLabel}: running ${running} tasks, but ${desired} are desired."
                        }

                        echo "✅ ${serviceLabel}: ACTIVE | Desired=${desired} | Running=${running} | Pending=${pending}"

                        return desired
                    }

                    // Set the service name using withEnv, not Groovy interpolation
                    // inside the shell command.
                    def frontendDesired
                    def backendDesired

                    withEnv(["SERVICE_NAME=${env.FRONTEND_SERVICE}"]) {
                        frontendDesired = checkEcsService(
                            env.FRONTEND_SERVICE,
                            'Frontend'
                        )
                    }

                    withEnv(["SERVICE_NAME=${env.BACKEND_SERVICE}"]) {
                        backendDesired = checkEcsService(
                            env.BACKEND_SERVICE,
                            'Backend'
                        )
                    }

                    // =====================================================
                    // 4. CHECK ALB TARGET HEALTH
                    //
                    // Pass when healthy targets meet the ECS desired count.
                    // "draining" targets are allowed during replacement.
                    // =====================================================

                    def checkTargetGroup = { targetGroupArn, serviceLabel, desiredCount ->

                        echo "🌐 Checking ${serviceLabel} ALB target health..."

                        def healthyCount = 0
                        def states = []

                        // Allow up to 5 minutes for ALB health checks to catch up.
                        for (int attempt = 1; attempt <= 20; attempt++) {

                            def targetOutput = sh(
                                label: "Read ${serviceLabel} ALB target states",
                                script: '''
                                    set -eu

                                    aws elbv2 describe-target-health \
                                        --target-group-arn "$TARGET_GROUP_ARN" \
                                        --region "$AWS_REGION" \
                                        --query 'TargetHealthDescriptions[].TargetHealth.State' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()

                            states = targetOutput
                                .tokenize()
                                .collect { it.toLowerCase() }

                            healthyCount = states.count { it == 'healthy' }

                            echo "${serviceLabel} target states: ${states ? states.join(', ') : 'NO TARGETS'}"
                            echo "${serviceLabel}: ${healthyCount} healthy target(s); ${desiredCount} required."

                            // Healthy capacity is available. Draining old targets
                            // do not cause a failure by themselves.
                            if (healthyCount >= desiredCount) {

                                def drainingCount = states.count { it == 'draining' }
                                def unhealthyCount = states.count { it == 'unhealthy' }

                                echo "✅ ${serviceLabel}: required healthy target capacity is available."

                                if (drainingCount > 0) {
                                    echo "ℹ️ ${serviceLabel}: ${drainingCount} old target(s) are draining."
                                }

                                if (unhealthyCount > 0) {
                                    echo "⚠️ ${serviceLabel}: ${unhealthyCount} target(s) are unhealthy, but healthy capacity meets the desired count."
                                }

                                return
                            }

                            if (attempt < 20) {
                                echo "⏳ Waiting 15 seconds for ${serviceLabel} targets to become healthy (attempt ${attempt}/20)..."
                                sleep(time: 15, unit: 'SECONDS')
                            }
                        }

                        error "❌ ${serviceLabel} ALB check failed: only ${healthyCount} healthy target(s); ${desiredCount} required. Final states: ${states ? states.join(', ') : 'NO TARGETS'}"
                    }

                    // Pass target group ARNs into the shell through environment variables.
                    withEnv(["TARGET_GROUP_ARN=${env.FRONTEND_TARGET_GROUP_ARN}"]) {
                        checkTargetGroup(
                            env.FRONTEND_TARGET_GROUP_ARN,
                            'Frontend',
                            frontendDesired
                        )
                    }

                    withEnv(["TARGET_GROUP_ARN=${env.BACKEND_TARGET_GROUP_ARN}"]) {
                        checkTargetGroup(
                            env.BACKEND_TARGET_GROUP_ARN,
                            'Backend',
                            backendDesired
                        )
                    }

                    // =====================================================
                    // 5. FINAL SUMMARY
                    // =====================================================

                    echo ""
                    echo "=========================================="
                    echo "✅ HEALTH CHECK PASSED"
                    echo "=========================================="
                    echo "Frontend ECS : HEALTHY"
                    echo "Frontend ALB : HEALTHY"
                    echo "Backend ECS  : HEALTHY"
                    echo "Backend ALB  : HEALTHY"
                    echo "🚀 Application deployment is healthy."
                    echo "=========================================="
                }
            }
        }


    }
}