pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        skipDefaultCheckout(false)
    }

    environment {

        // ==========================================
        // AWS CONFIGURATION
        // ==========================================

        AWS_REGION = 'ap-south-1'

        PROJECT_NAME = 'vms360'

        AWS_ACCESS_KEY_ID = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_ACCOUNT_ID = credentials('aws-rahul-account-id')

        S3_ENV_BUCKET = 'its360-secure-env-file'

        CODEBUILD_PROJECT_NAME = 'vms360-build'

        FRONTEND_ECR_REPOSITORY = 'vms360-frontend'
        BACKEND_ECR_REPOSITORY = 'vms360-backend'

        ECS_CLUSTER = 'its360-cluster'

        // ==========================================
        // ENVIRONMENT FILES
        // ==========================================

        BACKEND_PRODUCTION_ENV_S3_KEY = 'vms-360-backend-production-env'
        FRONTEND_PRODUCTION_ENV_S3_KEY = 'vms-360-frontend-production-env'

        BACKEND_STAGING_ENV_S3_KEY = 'vms-360-backend-production-env'
        FRONTEND_STAGING_ENV_S3_KEY = 'vms-360-frontend-production-env'

        // ==========================================
        // ECS TASK CONFIGURATION
        // ==========================================

        FRONTEND_TASK_DEFINITION_FAMILY = 'itsoftlab-360-vms360-frontend'
        BACKEND_TASK_DEFINITION_FAMILY = 'itsoftlab-360-vms360-backend'

        FRONTEND_CONTAINER_NAME = 'vms360-frontend'
        BACKEND_CONTAINER_NAME = 'vms360-backend'

        FRONTEND_CONTAINER_PORT = '80'
        BACKEND_CONTAINER_PORT = '5000'

        FRONTEND_CPU = '256'
        FRONTEND_MEMORY = '512'

        BACKEND_CPU = '256'
        BACKEND_MEMORY = '512'

        FRONTEND_HEALTH_PATH = '/api/health'
        BACKEND_HEALTH_PATH = '/api/health'

        // ==========================================
        // ECS SERVICES
        // ==========================================

        FRONTEND_SERVICE = 'vms360-frontend-service'
        BACKEND_SERVICE = 'vms360-backend-service'

        // ==========================================
        // APPLICATION LOAD BALANCERS
        // ==========================================

        FRONTEND_LOAD_BALANCER = 'master-load-balancer'
        BACKEND_LOAD_BALANCER = 'master-load-balancer'

        FRONTEND_TARGET_GROUP = 'vms360-frontend-tg'
        BACKEND_TARGET_GROUP = 'vms360-backend-tg'

        // ==========================================
        // NETWORK CONFIGURATION
        // ==========================================

        VPC_ID = 'vpc-08bb09e9a7c10b095'

        SUBNET_1 = 'subnet-06fe5b3d8e95ad780'
        SUBNET_2 = 'subnet-0cf9fd6f508540589'

        SECURITY_GROUP_1 = 'sg-05e021221abdb240e'
        SECURITY_GROUP_2 = 'sg-02f964fc431f9b80f'

        // ==========================================
        // IAM ROLES
        // ==========================================

        ECS_EXECUTION_ROLE_NAME = 'ecsTaskExecutionRole'
        ECS_TASK_ROLE_NAME = 'ecsTaskRole'

    }

    stages {

        // ==========================================
        // 1. VALIDATE GIT TAG
        // ==========================================

        stage('Validate Git Tag') {

            steps {

                script {

                    echo 'Validating Git tag and deployment branch...'

                    sh '''
                        set -eu

                        git fetch --tags origin

                        git fetch origin \
                            '+refs/heads/main:refs/remotes/origin/main' \
                            '+refs/heads/staging:refs/remotes/origin/staging'
                    '''

                    env.TAG_NAME = sh(
                        script: '''
                            git tag --points-at HEAD | sort -V | tail -n 1
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!env.TAG_NAME) {
                        error 'No Git tag detected at HEAD. Deployment requires a tagged commit.'
                    }

                    echo "Detected Tag: ${env.TAG_NAME}"

                    env.BRANCH = sh(
                        script: """
                            git branch -r --contains '${env.TAG_NAME}' |
                            grep -Eo 'origin/(main|staging)' |
                            head -n 1 |
                            cut -d '/' -f2 || true
                        """,
                        returnStdout: true
                    ).trim()

                    if (!env.BRANCH) {
                        error "Invalid tag. Tags must belong to main or staging."
                    }

                    if (
                        env.BRANCH == 'main' &&
                        env.TAG_NAME ==~ /^v\\d+\\.\\d+\\.\\d+$/
                    ) {

                        env.ENVIRONMENT = 'production'

                    } else if (
                        env.BRANCH == 'staging' &&
                        env.TAG_NAME ==~ /^v\\d+\\.\\d+\\.\\d+-staging$/
                    ) {

                        env.ENVIRONMENT = 'staging'

                    } else {

                        error "Invalid tag format for branch '${env.BRANCH}'."

                    }

                    echo '============================================'
                    echo 'GIT VALIDATION SUCCESSFUL'
                    echo '============================================'
                    echo "Project     : ${PROJECT_NAME}"
                    echo "Branch      : ${env.BRANCH}"
                    echo "Tag         : ${env.TAG_NAME}"
                    echo "Environment : ${env.ENVIRONMENT}"
                    echo '============================================'

                }

            }

        }

        // ==========================================
        // 2. CREATE DOCKER TAGS
        // ==========================================

        stage('Create Docker Tags') {

            steps {

                script {

                    env.BACKEND_TAG = "backend-${env.ENVIRONMENT}-${env.TAG_NAME}"

                    env.FRONTEND_TAG = "frontend-${env.ENVIRONMENT}-${env.TAG_NAME}"

                    echo "Backend Docker Tag : ${env.BACKEND_TAG}"
                    echo "Frontend Docker Tag: ${env.FRONTEND_TAG}"

                }

            }

        }

        // ==========================================
        // 3. DETERMINE SECRET KEY FILE
        // ==========================================

        stage('Determine Secret Key File') {

            steps {

                script {

                    if (!env.ENVIRONMENT) {
                        error 'ENVIRONMENT is not available.'
                    }

                    if (env.ENVIRONMENT == 'production') {

                        env.BACKEND_SECRET_KEY =
                            "${env.BACKEND_PRODUCTION_ENV_S3_KEY}.env"

                        env.FRONTEND_SECRET_KEY =
                            "${env.FRONTEND_PRODUCTION_ENV_S3_KEY}.env"

                    } else if (env.ENVIRONMENT == 'staging') {

                        env.BACKEND_SECRET_KEY =
                            "${env.BACKEND_STAGING_ENV_S3_KEY}.env"

                        env.FRONTEND_SECRET_KEY =
                            "${env.FRONTEND_STAGING_ENV_S3_KEY}.env"

                    } else {

                        error "Unknown deployment environment: ${env.ENVIRONMENT}"

                    }

                    echo "Backend environment file : ${env.BACKEND_SECRET_KEY}"
                    echo "Frontend environment file: ${env.FRONTEND_SECRET_KEY}"

                }

            }

        }

        // ==========================================
        // 4. CHECK AND TRIGGER CODEBUILD
        // ==========================================

        stage('Check and Trigger AWS CodeBuild') {

            steps {

                script {

                    echo 'Checking AWS CodeBuild project...'

                    def codeBuildStatus = sh(
                        script: """
                            aws codebuild batch-get-projects \
                                --names "${CODEBUILD_PROJECT_NAME}" \
                                --region "${AWS_REGION}" \
                                --query 'projects[0].name' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (
                        !codeBuildStatus ||
                        codeBuildStatus == 'None' ||
                        codeBuildStatus == 'null'
                    ) {

                        error "AWS CodeBuild project not found: ${CODEBUILD_PROJECT_NAME}"

                    }

                    echo "CodeBuild project exists: ${codeBuildStatus}"

                    // ----------------------------------
                    // CHECK BACKEND IMAGE
                    // ----------------------------------

                    def backendExists = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${BACKEND_ECR_REPOSITORY} \
                                --image-ids imageTag=${BACKEND_TAG} \
                                --region ${AWS_REGION} \
                                >/dev/null 2>&1
                        """,
                        returnStatus: true
                    ) == 0

                    // ----------------------------------
                    // CHECK FRONTEND IMAGE
                    // ----------------------------------

                    def frontendExists = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${FRONTEND_ECR_REPOSITORY} \
                                --image-ids imageTag=${FRONTEND_TAG} \
                                --region ${AWS_REGION} \
                                >/dev/null 2>&1
                        """,
                        returnStatus: true
                    ) == 0

                    // ----------------------------------
                    // ECR IMAGE URLS
                    // ----------------------------------

                    env.ECR_REGISTRY =
                        "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    env.FRONTEND_IMAGE =
                        "${env.ECR_REGISTRY}/${FRONTEND_ECR_REPOSITORY}:${env.FRONTEND_TAG}"

                    env.BACKEND_IMAGE =
                        "${env.ECR_REGISTRY}/${BACKEND_ECR_REPOSITORY}:${env.BACKEND_TAG}"

                    // ----------------------------------
                    // SKIP OR START CODEBUILD
                    // ----------------------------------

                    if (backendExists && frontendExists) {

                        env.CODEBUILD_BUILD_ID = 'SKIPPED'

                        echo 'Both exact Docker images already exist.'

                        echo "Frontend: ${env.FRONTEND_IMAGE}"
                        echo "Backend : ${env.BACKEND_IMAGE}"

                        echo 'Skipping CodeBuild.'

                    } else {

                        echo "Frontend image exists: ${frontendExists}"
                        echo "Backend image exists : ${backendExists}"

                        echo 'Starting AWS CodeBuild...'

                        // IMPORTANT:
                        // CodeBuild must publish BOTH images, including
                        // the image that already exists in ECR.

                        def buildId = sh(
                            script: """
                                aws codebuild start-build \
                                    --project-name "${CODEBUILD_PROJECT_NAME}" \
                                    --source-version "${TAG_NAME}" \
                                    --region "${AWS_REGION}" \
                                    --environment-variables-override \
                                        name=ENVIRONMENT,value=${ENVIRONMENT},type=PLAINTEXT \
                                        name=PROJECT_NAME,value=${PROJECT_NAME},type=PLAINTEXT \
                                        name=GIT_TAG,value=${TAG_NAME},type=PLAINTEXT \
                                        name=BACKEND_TAG,value=${BACKEND_TAG},type=PLAINTEXT \
                                        name=FRONTEND_TAG,value=${FRONTEND_TAG},type=PLAINTEXT \
                                        name=BACKEND_SECRET_KEY,value=${BACKEND_SECRET_KEY},type=PLAINTEXT \
                                        name=FRONTEND_SECRET_KEY,value=${FRONTEND_SECRET_KEY},type=PLAINTEXT \
                                        name=S3_ENV_BUCKET,value=${S3_ENV_BUCKET},type=PLAINTEXT \
                                    --query 'build.id' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()

                        if (
                            !buildId ||
                            buildId == 'None' ||
                            buildId == 'null'
                        ) {

                            error 'Failed to start AWS CodeBuild.'

                        }

                        env.CODEBUILD_BUILD_ID = buildId

                        echo "CodeBuild started: ${env.CODEBUILD_BUILD_ID}"

                    }

                }

            }

        }

        // ==========================================
        // 5. WAIT FOR CODEBUILD
        // ==========================================

        stage('Wait for AWS CodeBuild Completion') {

            when {

                expression {
                    env.CODEBUILD_BUILD_ID &&
                    env.CODEBUILD_BUILD_ID != 'SKIPPED'
                }

            }

            steps {

                script {

                    timeout(time: 30, unit: 'MINUTES') {

                        def buildStatus = ''

                        while (true) {

                            buildStatus = sh(
                                script: """
                                    aws codebuild batch-get-builds \
                                        --ids "${CODEBUILD_BUILD_ID}" \
                                        --region "${AWS_REGION}" \
                                        --query 'builds[0].buildStatus' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()

                            echo "CodeBuild Status: ${buildStatus}"

                            if ([
                                'SUCCEEDED',
                                'FAILED',
                                'STOPPED',
                                'FAULT',
                                'TIMED_OUT'
                            ].contains(buildStatus)) {

                                break

                            }

                            if (
                                !buildStatus ||
                                buildStatus == 'None' ||
                                buildStatus == 'null'
                            ) {

                                error 'Unable to retrieve CodeBuild status.'

                            }

                            sleep(time: 10, unit: 'SECONDS')

                        }

                        if (buildStatus != 'SUCCEEDED') {

                            error "CodeBuild failed: ${buildStatus}"

                        }

                        echo 'AWS CodeBuild completed successfully.'

                    }

                }

            }

        }

        // ==========================================
        // 6. VERIFY ECR IMAGES
        // ==========================================

        stage('Verify ECR Images') {

            steps {

                script {

                    echo 'Verifying frontend and backend ECR images...'

                    def frontendDigest = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${FRONTEND_ECR_REPOSITORY} \
                                --image-ids imageTag=${FRONTEND_TAG} \
                                --region ${AWS_REGION} \
                                --query 'imageDetails[0].imageDigest' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    def backendDigest = sh(
                        script: """
                            aws ecr describe-images \
                                --repository-name ${BACKEND_ECR_REPOSITORY} \
                                --image-ids imageTag=${BACKEND_TAG} \
                                --region ${AWS_REGION} \
                                --query 'imageDetails[0].imageDigest' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (
                        !frontendDigest ||
                        frontendDigest == 'None' ||
                        backendDigest == 'None' ||
                        !backendDigest
                    ) {

                        error 'Required frontend or backend ECR image is missing.'

                    }

                    echo "Frontend Image: ${env.FRONTEND_IMAGE}"
                    echo "Backend Image : ${env.BACKEND_IMAGE}"

                    echo 'Both ECR images verified successfully.'

                }

            }

        }

        // ==========================================
        // 7. GENERATE FRONTEND TASK DEFINITION
        // ==========================================

        stage('Generate Frontend Task Definition') {

            steps {

                script {

                    env.FRONTEND_TASK_FAMILY =
                        "${FRONTEND_TASK_DEFINITION_FAMILY}"

                    env.FRONTEND_EXECUTION_ROLE =
                        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${ECS_EXECUTION_ROLE_NAME}"

                    env.FRONTEND_TASK_ROLE =
                        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${ECS_TASK_ROLE_NAME}"

                    env.FRONTEND_LOG_GROUP =
                        "/ecs/${FRONTEND_TASK_FAMILY}"

                    env.FRONTEND_ENV_FILE_ARN =
                        "arn:aws:s3:::${S3_ENV_BUCKET}/${FRONTEND_SECRET_KEY}"

                    echo 'Generating frontend task definition...'

                    sh """
                        cat > frontend-task-definition.json <<'EOF'
                        {
                            "family": "${FRONTEND_TASK_FAMILY}",
                            "executionRoleArn": "${FRONTEND_EXECUTION_ROLE}",
                            "taskRoleArn": "${FRONTEND_TASK_ROLE}",
                            "networkMode": "awsvpc",
                            "requiresCompatibilities": ["FARGATE"],
                            "cpu": "${FRONTEND_CPU}",
                            "memory": "${FRONTEND_MEMORY}",
                            "runtimePlatform": {
                                "cpuArchitecture": "X86_64",
                                "operatingSystemFamily": "LINUX"
                            },
                            "containerDefinitions": [
                                {
                                    "name": "${FRONTEND_CONTAINER_NAME}",
                                    "image": "${FRONTEND_IMAGE}",
                                    "cpu": 0,
                                    "portMappings": [
                                        {
                                            "containerPort": ${FRONTEND_CONTAINER_PORT},
                                            "hostPort": ${FRONTEND_CONTAINER_PORT},
                                            "protocol": "tcp"
                                        }
                                    ],
                                    "essential": true,
                                    "environment": [],
                                    "environmentFiles": [
                                        {
                                            "value": "${FRONTEND_ENV_FILE_ARN}",
                                            "type": "s3"
                                        }
                                    ],
                                    "mountPoints": [],
                                    "volumesFrom": [],
                                    "ulimits": [],
                                    "logConfiguration": {
                                        "logDriver": "awslogs",
                                        "options": {
                                            "awslogs-group": "${FRONTEND_LOG_GROUP}",
                                            "awslogs-create-group": "true",
                                            "awslogs-region": "${AWS_REGION}",
                                            "awslogs-stream-prefix": "ecs"
                                        }
                                    },
                                    "healthCheck": {
                                        "command": [
                                            "CMD-SHELL",
                                            "curl -f http://127.0.0.1:${FRONTEND_CONTAINER_PORT}${FRONTEND_HEALTH_PATH} || exit 1"
                                        ],
                                        "interval": 30,
                                        "timeout": 5,
                                        "retries": 3,
                                        "startPeriod": 10
                                    }
                                }
                            ]
                        }
                        EOF

                        jq empty frontend-task-definition.json
                    """

                    echo 'Frontend task definition generated successfully.'

                    sh """
                        jq '{
                            family,
                            cpu,
                            memory,
                            networkMode,
                            containerDefinitions: [
                                {
                                    name: .containerDefinitions[0].name,
                                    image: .containerDefinitions[0].image,
                                    portMappings: .containerDefinitions[0].portMappings,
                                    healthCheck: .containerDefinitions[0].healthCheck
                                }
                            ]
                        }' frontend-task-definition.json
                    """

                }

            }

        }

        // ==========================================
        // 8. GENERATE BACKEND TASK DEFINITION
        // ==========================================

        stage('Generate Backend Task Definition') {

            steps {

                script {

                    env.BACKEND_TASK_FAMILY =
                        "${BACKEND_TASK_DEFINITION_FAMILY}"

                    env.BACKEND_EXECUTION_ROLE =
                        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${ECS_EXECUTION_ROLE_NAME}"

                    env.BACKEND_TASK_ROLE =
                        "arn:aws:iam::${AWS_ACCOUNT_ID}:role/${ECS_TASK_ROLE_NAME}"

                    env.BACKEND_LOG_GROUP =
                        "/ecs/${BACKEND_TASK_FAMILY}"

                    env.BACKEND_ENV_FILE_ARN =
                        "arn:aws:s3:::${S3_ENV_BUCKET}/${BACKEND_SECRET_KEY}"

                    echo 'Generating backend task definition...'

                    sh """
cat > backend-task-definition.json <<'EOF'
{
    "family": "${BACKEND_TASK_FAMILY}",
    "executionRoleArn": "${BACKEND_EXECUTION_ROLE}",
    "taskRoleArn": "${BACKEND_TASK_ROLE}",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "${BACKEND_CPU}",
    "memory": "${BACKEND_MEMORY}",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "${BACKEND_CONTAINER_NAME}",
            "image": "${BACKEND_IMAGE}",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": ${BACKEND_CONTAINER_PORT},
                    "hostPort": ${BACKEND_CONTAINER_PORT},
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [],
            "environmentFiles": [
                {
                    "value": "${BACKEND_ENV_FILE_ARN}",
                    "type": "s3"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "${BACKEND_LOG_GROUP}",
                    "awslogs-create-group": "true",
                    "awslogs-region": "${AWS_REGION}",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "curl --fail --silent http://127.0.0.1:${BACKEND_CONTAINER_PORT}${BACKEND_HEALTH_PATH} > /dev/null || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 60
            }
        }
    ]
}
EOF

                        jq empty backend-task-definition.json
                    """

                    echo 'Backend task definition generated successfully.'

                    sh """
                        jq '{
                            family,
                            cpu,
                            memory,
                            networkMode,
                            containerDefinitions: [
                                {
                                    name: .containerDefinitions[0].name,
                                    image: .containerDefinitions[0].image,
                                    portMappings: .containerDefinitions[0].portMappings,
                                    healthCheck: .containerDefinitions[0].healthCheck
                                }
                            ]
                        }' backend-task-definition.json
                    """

                }

            }

        }

        // ==========================================
        // 9. REGISTER TASK DEFINITIONS
        // ==========================================

        stage('Register Task Definitions') {

            steps {

                script {

                    echo 'Registering frontend task definition...'

                    def frontendTaskArn = sh(
                        script: """
                            aws ecs register-task-definition \
                                --cli-input-json file://frontend-task-definition.json \
                                --region ${AWS_REGION} \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (
                        !frontendTaskArn ||
                        frontendTaskArn == 'None'
                    ) {

                        error 'Frontend task definition registration failed.'

                    }

                    env.FRONTEND_TASK_DEFINITION_ARN = frontendTaskArn

                    echo "Frontend Task: ${frontendTaskArn}"

                    echo 'Registering backend task definition...'

                    def backendTaskArn = sh(
                        script: """
                            aws ecs register-task-definition \
                                --cli-input-json file://backend-task-definition.json \
                                --region ${AWS_REGION} \
                                --query 'taskDefinition.taskDefinitionArn' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (
                        !backendTaskArn ||
                        backendTaskArn == 'None'
                    ) {

                        error 'Backend task definition registration failed.'

                    }

                    env.BACKEND_TASK_DEFINITION_ARN = backendTaskArn

                    echo "Backend Task: ${backendTaskArn}"

                    echo 'Both task definitions registered successfully.'

                }

            }

        }

        // ==========================================
        // 10. CREATE / UPDATE ECS SERVICES
        // ==========================================

        stage('Create/Update ECS Services') {

            steps {

                script {

                    echo '============================================'
                    echo 'VMS AWS INFRASTRUCTURE VALIDATION'
                    echo '============================================'

                    // ----------------------------------
                    // VALIDATE REQUIRED CONFIGURATION
                    // ----------------------------------

                    def requiredVariables = [
                        'VPC_ID',
                        'SUBNET_1',
                        'SUBNET_2',
                        'SECURITY_GROUP_1',
                        'SECURITY_GROUP_2',
                        'FRONTEND_TASK_DEFINITION_ARN',
                        'BACKEND_TASK_DEFINITION_ARN'
                    ]

                    requiredVariables.each { variable ->

                        if (!env[variable]?.trim()) {
                            error "Missing AWS configuration: ${variable}"
                        }

                    }

                    // ----------------------------------
                    // VALIDATE VPC AND CLUSTER
                    // ----------------------------------

                    def clusterStatus = sh(
                        script: """
                            aws ecs describe-clusters \
                                --clusters ${ECS_CLUSTER} \
                                --region ${AWS_REGION} \
                                --query 'clusters[0].status' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (clusterStatus != 'ACTIVE') {
                        error "ECS cluster is not ACTIVE: ${clusterStatus}"
                    }

                    def vpcStatus = sh(
                        script: """
                            aws ec2 describe-vpcs \
                                --vpc-ids ${VPC_ID} \
                                --region ${AWS_REGION} \
                                --query 'Vpcs[0].State' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    if (vpcStatus != 'available') {
                        error "VPC is not available: ${VPC_ID}"
                    }

                    echo 'ECS cluster and VPC validated.'

                    // ----------------------------------
                    // VERIFY SUBNETS BELONG TO VPC
                    // ----------------------------------

                    def subnetDetails = sh(
                        script: """
                            aws ec2 describe-subnets \
                                --subnet-ids ${SUBNET_1} ${SUBNET_2} \
                                --region ${AWS_REGION} \
                                --query 'Subnets[].VpcId' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim().tokenize()

                    if (
                        subnetDetails.size() != 2 ||
                        subnetDetails.any { it != env.VPC_ID }
                    ) {

                        error 'Configured subnets do not belong to the configured VPC.'

                    }

                    // ----------------------------------
                    // VERIFY SECURITY GROUPS
                    // ----------------------------------

                    def securityGroupVpcs = sh(
                        script: """
                            aws ec2 describe-security-groups \
                                --group-ids ${SECURITY_GROUP_1} ${SECURITY_GROUP_2} \
                                --region ${AWS_REGION} \
                                --query 'SecurityGroups[].VpcId' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim().tokenize()

                    if (
                        securityGroupVpcs.size() != 2 ||
                        securityGroupVpcs.any { it != env.VPC_ID }
                    ) {

                        error 'Configured security groups do not belong to the VMS VPC.'

                    }

                    // ==================================
                    // FRONTEND AND BACKEND ALB CREATION
                    // ==================================

                    def getOrCreateALB = { albName ->

                        def arn = sh(
                            script: """
                                aws elbv2 describe-load-balancers \
                                    --names ${albName} \
                                    --region ${AWS_REGION} \
                                    --query 'LoadBalancers[0].LoadBalancerArn' \
                                    --output text 2>/dev/null || true
                            """,
                            returnStdout: true
                        ).trim()

                        if (!arn || arn == 'None') {

                            echo "Creating ALB: ${albName}"

                            arn = sh(
                                script: """
                                    aws elbv2 create-load-balancer \
                                        --name ${albName} \
                                        --type application \
                                        --scheme internet-facing \
                                        --subnets ${SUBNET_1} ${SUBNET_2} \
                                        --security-groups ${SECURITY_GROUP_1} ${SECURITY_GROUP_2} \
                                        --region ${AWS_REGION} \
                                        --query 'LoadBalancers[0].LoadBalancerArn' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()

                        } else {

                            echo "ALB already exists: ${albName}"

                        }

                        if (!arn || arn == 'None') {
                            error "Failed to create/find ALB: ${albName}"
                        }

                        return arn

                    }

                    env.FRONTEND_LOAD_BALANCER_ARN =
                        getOrCreateALB(env.FRONTEND_LOAD_BALANCER)

                    env.BACKEND_LOAD_BALANCER_ARN =
                        getOrCreateALB(env.BACKEND_LOAD_BALANCER)

                    // ----------------------------------
                    // WAIT FOR ALBS TO BECOME ACTIVE
                    // ----------------------------------

                    timeout(time: 10, unit: 'MINUTES') {

                        sh """
                            aws elbv2 wait load-balancer-available \
                                --load-balancer-arns ${FRONTEND_LOAD_BALANCER_ARN} ${BACKEND_LOAD_BALANCER_ARN} \
                                --region ${AWS_REGION}
                        """

                    }

                    // ==================================
                    // TARGET GROUP CREATION
                    // ==================================

                    def getOrCreateTargetGroup = {
                        tgName,
                        port,
                        healthPath ->

                        def arn = sh(
                            script: """
                                aws elbv2 describe-target-groups \
                                    --names ${tgName} \
                                    --region ${AWS_REGION} \
                                    --query 'TargetGroups[0].TargetGroupArn' \
                                    --output text 2>/dev/null || true
                            """,
                            returnStdout: true
                        ).trim()

                        if (!arn || arn == 'None') {

                            echo "Creating target group: ${tgName}"

                            arn = sh(
                                script: """
                                    aws elbv2 create-target-group \
                                        --name ${tgName} \
                                        --protocol HTTP \
                                        --port ${port} \
                                        --target-type ip \
                                        --vpc-id ${VPC_ID} \
                                        --health-check-protocol HTTP \
                                        --health-check-path '${healthPath}' \
                                        --health-check-port traffic-port \
                                        --health-check-interval-seconds 30 \
                                        --health-check-timeout-seconds 5 \
                                        --healthy-threshold-count 2 \
                                        --unhealthy-threshold-count 3 \
                                        --region ${AWS_REGION} \
                                        --query 'TargetGroups[0].TargetGroupArn' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()

                        } else {

                            echo "Target group already exists: ${tgName}"

                        }

                        if (!arn || arn == 'None') {
                            error "Failed to create/find target group: ${tgName}"
                        }

                        return arn

                    }

                    env.FRONTEND_TARGET_GROUP_ARN =
                        getOrCreateTargetGroup(
                            env.FRONTEND_TARGET_GROUP,
                            env.FRONTEND_CONTAINER_PORT,
                            env.FRONTEND_HEALTH_PATH
                        )

                    env.BACKEND_TARGET_GROUP_ARN =
                        getOrCreateTargetGroup(
                            env.BACKEND_TARGET_GROUP,
                            env.BACKEND_CONTAINER_PORT,
                            env.BACKEND_HEALTH_PATH
                        )

                    // ----------------------------------
                    // VALIDATE TARGET GROUPS
                    // ----------------------------------

                    def validateTargetGroup = {
                        arn,
                        name,
                        expectedPort ->

                        def details = sh(
                            script: """
                                aws elbv2 describe-target-groups \
                                    --target-group-arns ${arn} \
                                    --region ${AWS_REGION} \
                                    --query 'TargetGroups[0].[VpcId,TargetType,Port]' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim().tokenize()

                        if (
                            details.size() < 3 ||
                            details[0] != env.VPC_ID ||
                            details[1] != 'ip' ||
                            details[2].toInteger() != expectedPort.toInteger()
                        ) {

                            error "Target group configuration mismatch: ${name}"

                        }

                        echo "${name} target group validated."

                    }

                    validateTargetGroup(
                        env.FRONTEND_TARGET_GROUP_ARN,
                        'Frontend',
                        env.FRONTEND_CONTAINER_PORT
                    )

                    validateTargetGroup(
                        env.BACKEND_TARGET_GROUP_ARN,
                        'Backend',
                        env.BACKEND_CONTAINER_PORT
                    )

                    // ----------------------------------
                    // ENSURE TARGET GROUP HEALTH PATHS
                    // ----------------------------------

                    sh """
                        aws elbv2 modify-target-group \
                            --target-group-arn ${FRONTEND_TARGET_GROUP_ARN} \
                            --health-check-protocol HTTP \
                            --health-check-path '${FRONTEND_HEALTH_PATH}' \
                            --health-check-port traffic-port \
                            --region ${AWS_REGION}

                        aws elbv2 modify-target-group \
                            --target-group-arn ${BACKEND_TARGET_GROUP_ARN} \
                            --health-check-protocol HTTP \
                            --health-check-path '${BACKEND_HEALTH_PATH}' \
                            --health-check-port traffic-port \
                            --region ${AWS_REGION}
                    """

                    // ==================================
                    // CREATE / UPDATE LISTENERS
                    // ==================================

                    def getOrCreateListener = {
                        albArn,
                        tgArn,
                        label ->

                        def listenerArn = sh(
                            script: """
                                aws elbv2 describe-listeners \
                                    --load-balancer-arn ${albArn} \
                                    --region ${AWS_REGION} \
                                    --query 'Listeners[?Port==\\`80\\`].ListenerArn | [0]' \
                                    --output text 2>/dev/null || true
                            """,
                            returnStdout: true
                        ).trim()

                        if (!listenerArn || listenerArn == 'None') {

                            echo "Creating ${label} HTTP listener..."

                            listenerArn = sh(
                                script: """
                                    aws elbv2 create-listener \
                                        --load-balancer-arn ${albArn} \
                                        --protocol HTTP \
                                        --port 80 \
                                        --default-actions Type=forward,TargetGroupArn=${tgArn} \
                                        --region ${AWS_REGION} \
                                        --query 'Listeners[0].ListenerArn' \
                                        --output text
                                """,
                                returnStdout: true
                            ).trim()

                        } else {

                            sh """
                                aws elbv2 modify-listener \
                                    --listener-arn ${listenerArn} \
                                    --default-actions Type=forward,TargetGroupArn=${tgArn} \
                                    --region ${AWS_REGION}
                            """

                            echo "${label} listener updated."

                        }

                        if (!listenerArn || listenerArn == 'None') {
                            error "Failed to create/find ${label} listener."
                        }

                        return listenerArn

                    }

                    env.FRONTEND_LISTENER_ARN =
                        getOrCreateListener(
                            env.FRONTEND_LOAD_BALANCER_ARN,
                            env.FRONTEND_TARGET_GROUP_ARN,
                            'Frontend'
                        )

                    env.BACKEND_LISTENER_ARN =
                        getOrCreateListener(
                            env.BACKEND_LOAD_BALANCER_ARN,
                            env.BACKEND_TARGET_GROUP_ARN,
                            'Backend'
                        )

                    // ==================================
                    // CREATE / UPDATE ECS SERVICES
                    // ==================================

                    def createOrUpdateService = {
                        serviceName,
                        taskDefinitionArn,
                        containerName,
                        containerPort,
                        targetGroupArn ->

                        def serviceArn = sh(
                            script: """
                                aws ecs describe-services \
                                    --cluster ${ECS_CLUSTER} \
                                    --services ${serviceName} \
                                    --region ${AWS_REGION} \
                                    --query 'services[0].serviceArn' \
                                    --output text 2>/dev/null || true
                            """,
                            returnStdout: true
                        ).trim()

                        if (!serviceArn || serviceArn == 'None') {

                            echo "Creating ECS service: ${serviceName}"

                            sh """
                                aws ecs create-service \
                                    --cluster ${ECS_CLUSTER} \
                                    --service-name ${serviceName} \
                                    --task-definition ${taskDefinitionArn} \
                                    --desired-count 1 \
                                    --launch-type FARGATE \
                                    --platform-version 1.4.0 \
                                    --enable-execute-command \
                                    --network-configuration "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${SECURITY_GROUP_1},${SECURITY_GROUP_2}],assignPublicIp=ENABLED}" \
                                    --load-balancers "targetGroupArn=${targetGroupArn},containerName=${containerName},containerPort=${containerPort}" \
                                    --region ${AWS_REGION}
                            """

                            echo "${serviceName} created."

                        } else {

                            echo "Updating ECS service: ${serviceName}"

                            sh """
                                aws ecs update-service \
                                    --cluster ${ECS_CLUSTER} \
                                    --service ${serviceName} \
                                    --task-definition ${taskDefinitionArn} \
                                    --desired-count 1 \
                                    --load-balancers "targetGroupArn=${targetGroupArn},containerName=${containerName},containerPort=${containerPort}" \
                                    --network-configuration "awsvpcConfiguration={subnets=[${SUBNET_1},${SUBNET_2}],securityGroups=[${SECURITY_GROUP_1},${SECURITY_GROUP_2}],assignPublicIp=ENABLED}" \
                                    --force-new-deployment \
                                    --region ${AWS_REGION}
                            """

                            echo "${serviceName} updated."

                        }

                    }

                    createOrUpdateService(
                        env.FRONTEND_SERVICE,
                        env.FRONTEND_TASK_DEFINITION_ARN,
                        env.FRONTEND_CONTAINER_NAME,
                        env.FRONTEND_CONTAINER_PORT.toInteger(),
                        env.FRONTEND_TARGET_GROUP_ARN
                    )

                    createOrUpdateService(
                        env.BACKEND_SERVICE,
                        env.BACKEND_TASK_DEFINITION_ARN,
                        env.BACKEND_CONTAINER_NAME,
                        env.BACKEND_CONTAINER_PORT.toInteger(),
                        env.BACKEND_TARGET_GROUP_ARN
                    )

                    echo '============================================'
                    echo 'VMS ECS SERVICES CREATED / UPDATED'
                    echo '============================================'

                }

            }

        }

        // ==========================================
        // 11. WAIT FOR ECS STABILITY
        // ==========================================

        stage('Wait for ECS Stability') {

            steps {

                script {

                    echo 'Waiting for frontend and backend ECS services...'

                    timeout(time: 20, unit: 'MINUTES') {

                        sh '''
                            set -eu

                            aws ecs wait services-stable \
                                --cluster "$ECS_CLUSTER" \
                                --services "$FRONTEND_SERVICE" "$BACKEND_SERVICE" \
                                --region "$AWS_REGION"
                        '''

                    }

                    echo 'Both ECS services are stable.'

                    sh '''
                        aws ecs describe-services \
                            --cluster "$ECS_CLUSTER" \
                            --services "$FRONTEND_SERVICE" "$BACKEND_SERVICE" \
                            --region "$AWS_REGION" \
                            --query 'services[].{
                                Service:serviceName,
                                Status:status,
                                Desired:desiredCount,
                                Running:runningCount,
                                Pending:pendingCount
                            }' \
                            --output table
                    '''

                }

            }

        }

        // ==========================================
        // 12. FINAL HEALTH CHECK
        // ==========================================

        stage('Health Check') {

            steps {

                script {

                    echo '============================================'
                    echo 'VMS APPLICATION HEALTH CHECK'
                    echo '============================================'

                    // ----------------------------------
                    // VALIDATE REQUIRED VARIABLES
                    // ----------------------------------

                    def requiredVariables = [
                        'AWS_REGION',
                        'ECS_CLUSTER',
                        'FRONTEND_SERVICE',
                        'BACKEND_SERVICE',
                        'FRONTEND_TARGET_GROUP_ARN',
                        'BACKEND_TARGET_GROUP_ARN'
                    ]

                    requiredVariables.each { variable ->

                        if (!env[variable]?.trim()) {
                            error "Missing required variable: ${variable}"
                        }

                    }

                    // ----------------------------------
                    // CHECK ECS SERVICE
                    // ----------------------------------

                    def checkEcsService = {
                        serviceName,
                        label ->

                        def serviceInfo = ''

                        withEnv(["SERVICE_NAME=${serviceName}"]) {

                            serviceInfo = sh(
                                script: '''
                                    set -eu

                                    aws ecs describe-services \
                                        --cluster "$ECS_CLUSTER" \
                                        --services "$SERVICE_NAME" \
                                        --region "$AWS_REGION" \
                                        --query 'services[0].[status,desiredCount,runningCount,pendingCount]' \
                                        --output text
                                ''',
                                returnStdout: true
                            ).trim()

                        }

                        def values = serviceInfo.tokenize()

                        if (
                            values.size() < 4 ||
                            values[0] == 'None'
                        ) {

                            error "Unable to retrieve ${label} ECS service details."

                        }

                        def status = values[0]
                        def desired = values[1].toInteger()
                        def running = values[2].toInteger()
                        def pending = values[3].toInteger()

                        if (status != 'ACTIVE') {
                            error "${label} ECS service is not ACTIVE."
                        }

                        if (desired < 1) {
                            error "${label} ECS service has no desired tasks."
                        }

                        if (running < desired) {
                            error "${label}: Running ${running}, Desired ${desired}."
                        }

                        echo "${label}: ACTIVE | Desired=${desired} | Running=${running} | Pending=${pending}"

                        return desired

                    }

                    def frontendDesired = checkEcsService(
                        env.FRONTEND_SERVICE,
                        'Frontend'
                    )

                    def backendDesired = checkEcsService(
                        env.BACKEND_SERVICE,
                        'Backend'
                    )

                    // ----------------------------------
                    // CHECK ALB TARGET HEALTH
                    // ----------------------------------

                    def checkTargetGroup = {
                        targetGroupArn,
                        label,
                        desiredCount ->

                        def healthyCount = 0
                        def states = []

                        for (int attempt = 1; attempt <= 20; attempt++) {

                            def targetOutput = ''

                            withEnv([
                                "TARGET_GROUP_ARN=${targetGroupArn}"
                            ]) {

                                targetOutput = sh(
                                    script: '''
                                        set -eu

                                        aws elbv2 describe-target-health \
                                            --target-group-arn "$TARGET_GROUP_ARN" \
                                            --region "$AWS_REGION" \
                                            --query 'TargetHealthDescriptions[].TargetHealth.State' \
                                            --output text
                                    ''',
                                    returnStdout: true
                                ).trim()

                            }

                            states = targetOutput
                                .tokenize()
                                .collect { it.toLowerCase() }

                            healthyCount = states.count {
                                it == 'healthy'
                            }

                            echo "${label} target states: ${states ? states.join(', ') : 'NO TARGETS'}"

                            echo "${label}: ${healthyCount} healthy / ${desiredCount} required."

                            if (healthyCount >= desiredCount) {

                                def drainingCount = states.count {
                                    it == 'draining'
                                }

                                echo "${label} ALB health check passed."

                                if (drainingCount > 0) {
                                    echo "${label}: ${drainingCount} old target(s) are draining."
                                }

                                return

                            }

                            if (attempt < 20) {

                                echo "Waiting for ${label} targets. Attempt ${attempt}/20."

                                sleep(time: 15, unit: 'SECONDS')

                            }

                        }

                        error "${label} ALB health check failed. Healthy=${healthyCount}, Required=${desiredCount}, States=${states}"

                    }

                    // ----------------------------------
                    // VERIFY FRONTEND
                    // ----------------------------------

                    checkTargetGroup(
                        env.FRONTEND_TARGET_GROUP_ARN,
                        'Frontend',
                        frontendDesired
                    )

                    // ----------------------------------
                    // VERIFY BACKEND
                    // ----------------------------------

                    checkTargetGroup(
                        env.BACKEND_TARGET_GROUP_ARN,
                        'Backend',
                        backendDesired
                    )

                    // ----------------------------------
                    // FINAL DEPLOYMENT SUMMARY
                    // ----------------------------------

                    echo ''
                    echo '============================================'
                    echo 'VMS DEPLOYMENT HEALTH CHECK PASSED'
                    echo '============================================'

                    echo "Project     : ${PROJECT_NAME}"
                    echo "Environment : ${env.ENVIRONMENT}"
                    echo "Git Tag     : ${env.TAG_NAME}"

                    echo 'Frontend ECS : HEALTHY'
                    echo 'Frontend ALB : HEALTHY'

                    echo 'Backend ECS  : HEALTHY'
                    echo 'Backend ALB  : HEALTHY'

                    echo '============================================'
                    echo 'VMS DEPLOYMENT SUCCESSFUL'
                    echo '============================================'

                }

            }

        }

    }

    post {

        success {

            echo '''
            ============================================
            VMS DEPLOYMENT COMPLETED SUCCESSFULLY
            ============================================
            '''

        }

        failure {

            echo '''
            ============================================
            VMS DEPLOYMENT FAILED
            ============================================
            Please check Jenkins Console Output,
            AWS CodeBuild logs, ECS events and
            CloudWatch application logs.
            ============================================
            '''

        }

        always {

            echo 'VMS Jenkins pipeline execution finished.'

        }

    }

}

